
@model List<WebApplication2.Models.Incident>

@{
    ViewData["Title"] = "Incident Dashboard";
}


<div class="mb-3">
    <a asp-controller="Incident"
       asp-action="Create"
       class="btn btn-primary">
        + Create New Incident
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Location</th>
            <th>Severity</th>
            <th>Reported Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var incident in Model)
        {


            
            <tr>
                <td>@incident.Id</td>

                <td>
                    <a asp-controller="Incident"
                       asp-action="Details"
                       asp-route-id="@incident.Id">
                        @incident.Title
                    </a>
                </td>

                <td>@incident.Location</td>
                <td>@incident.Severity</td>
                <td>@incident.ReportedAt.ToString("dd MMM yyyy")</td>

              
<td>
    <a asp-controller="Incident"
       asp-action="Edit"
       asp-route-id="@incident.Id"
       class="btn btn-sm btn-warning">
        Edit
    </a>

    <a asp-controller="Incident"
       asp-action="Delete"
       asp-route-id="@incident.Id"
       class="btn btn-sm btn-danger">
        Delete
    </a>
</td>

            </tr>
        }
    </tbody>
</table>
